generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("ADMIN")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model CompanySetting {
  id                 String   @id @default("default")
  companyName        String   @default("Prime Sublimation")
  logoUrl            String?
  address            String?  @default("402 Creative Heights, Design District, Bangalore - 560001")
  phone              String?  @default("+91 98765 43210")
  email              String?  @default("accounts@pixelcraftstudio.in")
  website            String?  @default("https://pixelcraftstudio.in")
  gstin              String?  @default("29AAAAA0000A1Z5")
  pan                String?  @default("AAAAA0000A")
  invoicePrefix      String   @default("INV-")
  invoiceNumberStart Int      @default(1001)
  orderPrefix        String   @default("ORD-")
  orderNumberStart   Int      @default(1001)
  defaultTaxRate     Float    @default(18.0)
  currency           String   @default("INR")
  currencySymbol     String   @default("₹")
  invoiceTerms       String?  @default("1. 50% advance for graphic design / print orders.\n2. Invoices are due within 15 days of issue.\n3. Revisions beyond 3 iterations will be billed at hourly rates.")
  paymentDetails     String?  @default("Payment can be made via UPI or NEFT/IMPS direct bank transfer.")
  bankAccountName    String?  @default("PixelCraft Design Studio LLP")
  bankAccountNumber  String?  @default("98765432101234")
  bankIfsc           String?  @default("HDFC0001234")
  bankName           String?  @default("HDFC Bank")
  bankBranch         String?  @default("MG Road, Bangalore")
  upiId              String?  @default("pixelcraft@hdfcbank")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Customer {
  id              String    @id @default(cuid())
  name            String
  companyName     String?
  mobile          String?
  email           String?
  gstin           String?
  pan             String?
  billingAddress  String?
  shippingAddress String?
  notes           String?
  status          String    @default("ACTIVE")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  invoices        Invoice[]
  orders          Order[]
}

model Item {
  id           String        @id @default(cuid())
  name         String
  sku          String?       @unique
  description  String?
  category     String        @default("Graphic Design")
  itemType     String        @default("SERVICE")
  price        Float         @default(0.0)
  costPrice    Float         @default(0.0)
  taxRate      Float         @default(18.0)
  unit         String        @default("PIECE")
  customUnit   String?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  invoiceItems InvoiceItem[]
  orderItems   OrderItem[]
}

model Order {
  id                   String      @id @default(cuid())
  orderNumber          String      @unique
  customerId           String
  assignedPartnerId    String?
  orderDate            DateTime    @default(now())
  expectedDate         DateTime?
  subtotal             Float       @default(0.0)
  taxTotal             Float       @default(0.0)
  discountTotal        Float       @default(0.0)
  grandTotal           Float       @default(0.0)
  status               String      @default("PENDING")
  notes                String?
  convertedToInvoiceId String?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  invoices             Invoice[]
  assignedPartner      Partner?    @relation(fields: [assignedPartnerId], references: [id])
  customer             Customer    @relation(fields: [customerId], references: [id])
  items                OrderItem[]
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  itemId      String?
  name        String
  description String?
  unit        String   @default("PIECE")
  pricingType String   @default("QTY_RATE")
  width       Float?
  height      Float?
  quantity    Float    @default(1.0)
  area        Float?
  rate        Float    @default(0.0)
  discount    Float    @default(0.0)
  taxRate     Float    @default(18.0)
  taxAmount   Float    @default(0.0)
  totalAmount Float    @default(0.0)
  createdAt   DateTime @default(now())
  item        Item?    @relation(fields: [itemId], references: [id])
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique
  customerId    String
  orderId       String?
  invoiceDate   DateTime      @default(now())
  dueDate       DateTime
  subtotal      Float         @default(0.0)
  taxTotal      Float         @default(0.0)
  discountTotal Float         @default(0.0)
  grandTotal    Float         @default(0.0)
  paidAmount    Float         @default(0.0)
  balanceAmount Float         @default(0.0)
  status        String        @default("DRAFT")
  notes         String?
  terms         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  order         Order?        @relation(fields: [orderId], references: [id])
  customer      Customer      @relation(fields: [customerId], references: [id])
  items         InvoiceItem[]
  payments      Payment[]
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  itemId      String?
  name        String
  description String?
  unit        String   @default("PIECE")
  pricingType String   @default("QTY_RATE")
  width       Float?
  height      Float?
  quantity    Float    @default(1.0)
  area        Float?
  rate        Float    @default(0.0)
  discount    Float    @default(0.0)
  taxRate     Float    @default(18.0)
  taxAmount   Float    @default(0.0)
  totalAmount Float    @default(0.0)
  createdAt   DateTime @default(now())
  item        Item?    @relation(fields: [itemId], references: [id])
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Payment {
  id              String   @id @default(cuid())
  paymentNumber   String   @unique
  invoiceId       String
  amount          Float
  paymentDate     DateTime @default(now())
  paymentMethod   String   @default("UPI")
  referenceNumber String?
  notes           String?
  createdAt       DateTime @default(now())
  invoice         Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Expense {
  id              String   @id @default(cuid())
  title           String
  category        String   @default("General")
  amount          Float
  date            DateTime @default(now())
  description     String?
  paymentMethod   String   @default("BANK_TRANSFER")
  referenceNumber String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Partner {
  id               String   @id @default(cuid())
  name             String
  email            String?
  phone            String?
  profitPercentage Float
  isActive         Boolean  @default(true)
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  passwordHint     String?
  permissions      String?  @default("[\"dashboard\",\"orders\",\"invoices\",\"reports\"]")
  orders           Order[]
}
